<% layout('layouts/boilerplate') %>
<div class="pv-wrap pv-journey-page"><% if(typeof validationError !== 'undefined' && validationError){ %><p role="alert" class="pv-note"><%= validationError %></p><% } %>
<% if(plan){ %>
  <section class="pv-journey-heading">
    <div><p class="pv-eyebrow">Scout · Your AI travel companion</p><h1>Your journey, brought together.</h1><p class="pv-lead"><%= plan.origin %> <span aria-hidden="true">→</span> <%= plan.destinationCity || plan.destinationAirport || plan.destination %><% if(plan.destinationCity || plan.destinationAirport){ %>, <%= plan.destination %><% } %></p><p><%= plan.petType === 'dog-and-cat' ? 'Dog and cat' : plan.petType %><% if(plan.departureDate){ %> · <%= plan.departureDate %><% } %></p></div>
    <a class="pv-text-link" href="#edit-journey">Add or edit trip details ↓</a>
  </section>
  <details hidden id="edit-journey" class="pv-edit-journey pv-itinerary-card pv-itinerary-editor" <%= plan.airlineId ? '' : 'open' %>>
    <summary><%= plan.airlineId ? 'Edit trip details' : 'Refine your trip' %></summary>
    <p class="pv-fine-print">Add any details you know to update your itinerary.</p>
    <%- include('../partials/tripForm',{countries,airlines,plan,refineTrip:true}) %>
  </details>
  <div id="journey-status" class="pv-scout-status" role="status" aria-live="polite" aria-busy="true"><span class="pv-ai-spinner" aria-hidden="true"></span><div><strong>Scout is putting your itinerary together</strong><p>Bringing destination requirements, airline guidance and preparation into one plan.</p></div></div>
  <div id="journey-result" hidden aria-busy="true"></div>
  <p class="pv-fine-print">AI organises the available policy information; it does not grant entry or confirm a booking. Official sources and any missing details are included with your plan.</p>
  <% if(plan.airlineId){ %>
  <details id="journey-flight-comparison" class="pv-itinerary-card pv-flight-sidebar">
    <summary>Compare other airlines</summary>
  <% } %>
  <div id="journey-flight-options" class="pv-journey-flights" data-country-url="<%= /^\/country\/[^?#]+\?petType=[a-z0-9-]+$/.test(plan.countryUrl || '') ? plan.countryUrl : '/getCountryRegulationList' %>">
  <% if(typeof transportDiscovery !== 'undefined' && transportDiscovery){ %><%- include('../partials/transportDiscovery',{discovery:transportDiscovery}) %><% } %>
  <%- include('../partials/airlineResearch',{researchScope:plan,autoSearchId:typeof autoSearchId!=='undefined'?autoSearchId:null}) %>
  </div>
  <% if(plan.airlineId){ %></details><% } %>
  <script id="journey-input" type="application/json"><%- JSON.stringify({plan,saved:savedJourney || null,signedIn:!!currentUser}).replace(/</g,'\\u003c') %></script>
  <script src="/journey-planner.js" defer></script>
<% }else{ %>
  <section class="pv-hero pv-plan-hero" aria-labelledby="plan-title">
    <div>
      <h1 id="plan-title">Plan your pet’s trip</h1>
      <p class="pv-lead">Get a trip plan from Scout with destination requirements, airline guidance and a preparation checklist.</p>
      <figure class="pv-family-hero">
        <img src="/images/emma.jpg" alt="Emma, a tan-and-white dog on the waterfront at sunset" width="1600" height="1200" decoding="async" fetchpriority="high">
        <figcaption>Emma, one of the dogs behind <a href="/aboutUs">PetVoyage</a>.</figcaption>
      </figure>
    </div>
    <%- include('../partials/tripForm',{countries,airlines}) %>
  </section>
<% } %>
<%- include('../partials/relatedStories',{stories: typeof plannerStories === 'undefined' ? [] : plannerStories}) %>
<%- include('../partials/storeSelections',{productLimit:3}) %>
<section class="pv-band" aria-labelledby="plan-more-title">
  <div>
    <h2 id="plan-more-title">Get ready for your trip</h2>
    <p><a href="/guides">Read our travel guides</a> · <a href="/findAVet">Find a vet</a> · <a href="https://petsvoyage.myshopify.com/collections">Shop by pet</a></p>
  </div>
  <a class="pv-button" href="/blog/new">Share your travel story →</a>
</section>
</div>
