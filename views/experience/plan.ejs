<% layout('layouts/boilerplate') %><div class="pv-wrap"><section class="pv-section"><p class="pv-eyebrow">One journey, a few thoughtful steps</p><h1>Your research plan</h1><% if (plan) { %><div class="pv-note"><h2><%= plan.origin %> → <%= plan.destination %></h2><p><%= plan.petType %><% if(plan.departureDate){ %> · Departure: <%= plan.departureDate %><% } %></p><p>This is a research checklist, not confirmation that your pet can enter or fly.</p></div><div class="pv-resource-grid"><a class="pv-resource-card" href="<%= plan.countryUrl %>"><h3>1. Check destination rules</h3><p>Confirm the species and origin-specific requirements with the official authority.</p></a><a class="pv-resource-card" href="/regulations/airlineList"><h3>2. Ask the operating airline</h3><p>Check every leg, aircraft, pet space and carrier size before booking.</p></a><a class="pv-resource-card" href="/findAVet"><h3>3. Prepare with your vet</h3><p>Discuss timing, documentation and your pet’s needs.</p></a></div><p><a href="/flights/searchFlights">Search flights</a> · <a href="/guides">Read preparation guides</a></p><% if(currentUser){ %><form method="post" action="/my-trips"><% ['origin','destination','petType','departureDate'].forEach(k=>{ %><input type="hidden" name="<%= k %>" value="<%= plan[k] %>"><% }) %><button class="pv-button">Save research plan to My trips</button></form><% }else{ %><p><a href="/auth/login">Sign in</a> to save a research plan to your account. This plan has not been saved.</p><% } %><% }else{ %><p>Choose your route to organise the next questions to research.</p><% } %></section><%- include('../partials/tripForm',{countries}) %></div>
