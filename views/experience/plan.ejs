<% layout('layouts/boilerplate') %>
<div class="pv-wrap pv-journey-page"><% if(typeof validationError !== 'undefined' && validationError){ %><p role="alert" class="pv-note"><%= validationError %></p><% } %>
<% if(plan){ %>
  <section class="pv-journey-heading">
    <div><p class="pv-eyebrow">Scout · Your AI travel companion</p><h1>Your journey, brought together.</h1><p class="pv-lead"><%= plan.origin %> <span aria-hidden="true">→</span> <%= plan.destinationCity || plan.destinationAirport || plan.destination %><% if(plan.destinationCity || plan.destinationAirport){ %>, <%= plan.destination %><% } %></p><p><%= plan.petType %><% if(plan.departureDate){ %> · <%= plan.departureDate %><% } %></p></div>
    <a class="pv-text-link" href="#edit-journey">Edit trip details ↓</a>
  </section>
  <div id="journey-status" class="pv-scout-status" role="status" aria-live="polite"><span class="pv-scout-orb" aria-hidden="true">✦</span><div><strong>Scout is putting your itinerary together</strong><p>Bringing destination requirements, airline guidance and preparation into one plan.</p></div></div>
  <div id="journey-result" hidden aria-busy="true"></div>
  <p class="pv-fine-print">AI organises the available policy information; it does not grant entry or confirm a booking. Official sources and any missing details are included with your plan.</p>
  <div id="journey-flight-options" class="pv-journey-flights" data-country-url="<%= /^\/country\/[^?#]+\?petType=[a-z0-9-]+$/.test(plan.countryUrl || '') ? plan.countryUrl : '/getCountryRegulationList' %>">
  <% if(typeof transportDiscovery !== 'undefined' && transportDiscovery){ %><%- include('../partials/transportDiscovery',{discovery:transportDiscovery}) %><% } %>
  <%- include('../partials/airlineResearch',{researchScope:plan,autoSearchId:typeof autoSearchId!=='undefined'?autoSearchId:null}) %>
  </div>
  <details id="edit-journey" class="pv-edit-journey"><summary>Edit your trip details</summary><%- include('../partials/tripForm',{countries,airlines,plan}) %></details>
  <script id="journey-input" type="application/json"><%- JSON.stringify({plan,saved:savedJourney || null,signedIn:!!currentUser}).replace(/</g,'\\u003c') %></script>
  <script src="/journey-planner.js" defer></script>
<% }else{ %>
  <section class="pv-section"><p class="pv-eyebrow">Scout · PetVoyage AI</p><h1>Let’s plan your pet’s journey.</h1><p>Tell Scout where you’re going. Your requirements, airline guidance and preparation will appear together.</p></section>
  <%- include('../partials/tripForm',{countries,airlines}) %>
<% } %>
</div>
