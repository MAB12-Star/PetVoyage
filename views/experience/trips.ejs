<% layout('layouts/boilerplate') %><link rel="stylesheet" href="/css/saved-trips.css"><div class="pv-wrap"><section class="pv-section"><p class="pv-eyebrow">Your planning workspace</p><h1><%= removed ? "Removed trips" : "My trips" %></h1><p><a href="<%= removed ? "/my-trips" : "/my-trips?removed=1" %>"><%= removed ? "Back to saved trips" : "View removed trips" %></a></p><p><a class="pv-button" href="/toDoList">Open my to-do board</a></p><%- include('../partials/petPhotoAccent',{photo:'family.jpg',photoAlt:'A tabby-and-white cat sitting in front of two dogs on a gray sofa',photoWidth:1600,photoHeight:1200,message:'Your plans have good company.',photoNote:'The PetVoyage family, photographed together at home.'}) %><p>Keep the research you explicitly save to your account. Rules may change; recheck official sources before travel.</p><% if(!currentUser){ %><div class="pv-note"><h2>Make room for your next journey.</h2><p>Sign in to see your saved research plans and itineraries.</p><a class="pv-button" href="/auth/login">Sign in</a></div><% }else{ %><h2>Saved trip plans</h2><% if(!plans.length){ %><p>No research plans saved yet. <a href="/plan">Start a plan</a>, then choose Save.</p><% } %><div class="pv-saved-trips"><% plans.forEach(p=>{ %><article class="pv-note pv-saved-trip"><%- include('../partials/tripRemove',{trip:p,kind:'plans',removed}) %><h3><%= p.origin %> → <%= p.destinationCity || p.destinationAirport || p.destination %></h3><p><%= p.petType %> <%= p.departureDate || '' %></p><% if(!removed){ %><a href="<% if(p.generatedPlan){ %>/plan?saved=<%= p._id %><% }else{ %>/plan?origin=<%= encodeURIComponent(p.origin) %>&amp;destination=<%= encodeURIComponent(p.destination) %>&amp;destinationCity=<%= encodeURIComponent(p.destinationCity || '') %>&amp;destinationAirport=<%= encodeURIComponent(p.destinationAirport || '') %>&amp;pet=<%= encodeURIComponent(p.petType) %>&amp;flightNumber=<%= encodeURIComponent(p.flightNumber || '') %>&amp;departure=<%= encodeURIComponent(p.departureDate || '') %>&amp;returnDate=<%= encodeURIComponent(p.returnDate || '') %>&amp;departureCity=<%= encodeURIComponent(p.departureCity || '') %>&amp;departureAirport=<%= encodeURIComponent(p.departureAirport || '') %>&amp;departureConfirmed=<%= p.departureConfirmed?'true':'' %>&amp;departureMismatchConfirmed=<%= p.departureMismatchConfirmed?'true':'' %><% } %>">Open trip plan →</a><% } %></article><% }) %></div><h2>Saved AI itineraries</h2><% if(!itineraries.length){ %><p>No AI itineraries saved yet.</p><% } %><% itineraries.forEach(p=>{ %><div class="pv-note pv-saved-trip"><%- include('../partials/tripRemove',{trip:p,kind:'itineraries',removed}) %><h3><%= p.country %> · <%= p.petType %></h3><p><%= p.airlineName || 'Airline not specified' %></p><% if(!removed){ %><a href="/dashboard">Open your existing saved itinerary in Profile →</a><% } %></div><% }) %><p><a href="/dashboard">Profile, favourites and documents</a> · <a href="/toDoList">Your saved to-do list</a></p><% } %><div class="pv-resource-grid"><a class="pv-resource-card" href="/plan"><h3>Start a research plan</h3></a><a class="pv-resource-card" href="/flights/searchFlights"><h3>Search flights</h3></a><a class="pv-resource-card" href="/findAVet"><h3>Find a vet</h3></a></div></section></div>
