<% layout('layouts/boilerplate') %><main class="pv-wrap pv-discovery-page"><header class="pv-page-heading"><p class="pv-eyebrow">Scout · Flights with your pet</p><h1>Find your flight.<br>Plan how your pet travels.</h1><p class="pv-lead">Passenger options first, with your pet’s travel arrangements alongside.</p></header><% if(typeof validationError!=='undefined'&&validationError){ %><p role="alert" class="pv-note"><%= validationError %></p><% } %><form class="pv-discovery-form" method="post" action="/flights/discover"><%- include('../partials/departureLocation') %><div class="pv-discovery-fields"><label for="discovery-origin">Leaving from<input id="discovery-origin" name="origin" value="<%= search.origin || '' %>" placeholder="Country" required maxlength="100"></label><label for="discovery-destination">Travelling to<input id="discovery-destination" name="destination" value="<%= search.destination || '' %>" placeholder="Destination country" required maxlength="100"></label><label for="destination-city">Destination city or airport<input id="destination-city" name="destinationCity" value="<%= search.destinationCity || '' %>" placeholder="e.g. Puerto Vallarta" maxlength="100" required></label><label for="discovery-city">Departure airport or city<input id="discovery-city" name="departureCity" value="<%= search.departureCity || '' %>" placeholder="Your departure" maxlength="100" required></label><label for="discovery-pet">Your companion<select id="discovery-pet" name="petType"><% [['dog','Dog'],['cat','Cat'],['bird','Bird'],['other','Other pet'],['assistance','Assistance dog']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= search.petType===value?'selected':'' %>><%= label %></option><% }) %></select></label><label for="discovery-date">Departure date (optional)<input type="date" id="discovery-date" name="departureDate" value="<%= search.departureDate || '' %>"></label><label for="discovery-return">Return date (optional)<input type="date" id="discovery-return" name="returnDate" value="<%= search.returnDate || '' %>"></label></div><input type="hidden" name="departureSource" value="<%= search.departureSource==='location-suggested'?'location':'manual' %>"><details><summary>More trip details</summary><label for="discovery-airport">Airport code (optional)<input id="discovery-airport" name="departureAirport" maxlength="3" pattern="[A-Za-z]{3}" value="<%= search.departureAirport || '' %>" placeholder="e.g. LAX"></label><label>Destination airport code (optional)<input name="destinationAirport" maxlength="3" pattern="[A-Za-z]{3}" value="<%= search.destinationAirport || '' %>" placeholder="e.g. PVR"></label></details><button class="pv-button" type="submit">Find airline &amp; route options →</button></form><%- include('../partials/airlineResearch',{researchScope:search,autoSearchId:typeof autoSearchId!=='undefined'?autoSearchId:null}) %><% if(discovery){ %><%- include('../partials/transportDiscovery',{discovery}) %><% }else{ %><section class="pv-note"><h2>Explore a route</h2><p>Search above for inline airline options and pet travel research. Live fares and pet spaces must be checked with the airline.</p><a href="/flights/searchFlights?origin=United%20States&amp;destination=Australia&amp;petType=dog&amp;departureCity=Los%20Angeles&amp;departureAirport=LAX">See the Los Angeles → Australia example</a></section><% } %><p><a data-airport-finder="true" href="/flights/searchFlights?legacy=1">Open the airport map</a></p></main><script src="/airport-handoff.js" defer></script>
