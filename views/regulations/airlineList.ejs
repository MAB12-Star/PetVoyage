<% layout('layouts/boilerplate') %>
<div class="pv-wrap pv-directory">
  <h1>Airline pet policies</h1>
  <p>Find your operating airline’s rules for flying with a pet.</p>
  <form class="pv-directory-lookup" method="get">
    <div class="pv-directory-fields">
      <label>Airline name<input name="q" type="search" value="<%= query %>" placeholder="e.g. Air Canada" class="form-control"></label>
      <label>Breed policy<select name="breed" class="form-select">
        <% for (const [value,label] of [['','All breed policies'],['all','All breeds explicitly allowed'],['restricted','Breed restrictions stated'],['unknown','Needs confirmation']]) { %>
          <option value="<%= value %>" <%= breed===value?'selected':'' %>><%= label %></option>
        <% } %>
      </select></label>
      <label>Results per page<select name="perPage" class="form-select">
        <% for (const size of [6,12,24,48]) { %><option <%= perPage===size?'selected':'' %>><%= size %></option><% } %>
      </select></label>
    </div>
    <fieldset class="pv-directory-filters"><legend>Travel options</legend>
      <% for (const [value,label] of [['cabin','In cabin'],['hold','In hold / cargo'],['shipping','Separate pet shipping'],['service','Service animals'],['esa','Emotional support animals']]) { %>
        <label><input type="checkbox" name="mode" value="<%= value %>" <%= modes.includes(value)?'checked':'' %>> <%= label %></label>
      <% } %>
    </fieldset>
    <button class="pv-button">Search airlines</button> <a href="/regulations/airlineList">Clear filters</a>
  </form>
  <div class="pv-directory-columns">
    <section>
      <h2>Browse airlines</h2><p><%= totalAirlines %> results</p>
      <% if (!airlines.length) { %><p><%= breed==='all' ? 'No airline in this directory has an explicitly verified all-breeds policy. Check the operating airline for your breed, route and travel mode.' : 'No airlines match these filters.' %></p><% } %>
      <div class="pv-directory-results">
        <% for (const airline of airlines) { %>
          <article class="pv-note pv-directory-card">
            <% if (airline.logo) { %><img class="pv-directory-logo" src="<%= airline.logo %>" alt="" width="96" height="52" loading="lazy"><% } %>
            <h3><%= airline.name %></h3>
            <p><%= /^yes$/i.test(airline.dangerousBreeds) ? 'Breed restrictions stated' : 'Confirm breed policy with the airline' %></p>
            <a href="/airlines/<%= encodeURIComponent(airline.slug) %>">View pet policy →</a>
          </article>
        <% } %>
      </div>
      <% if (totalPages > 1) { %><nav aria-label="Airline results pages" class="pv-directory-pages">
        <% if (currentPage>1) { %><a href="<%= pageUrl(currentPage-1) %>">Previous</a><% } %>
        <span>Page <%= currentPage %> of <%= totalPages %></span>
        <% if (currentPage<totalPages) { %><a href="<%= pageUrl(currentPage+1) %>">Next</a><% } %>
      </nav><% } %>
      <%- include('../partials/ads/ad-image',{ad:typeof getAd==='function'?getAd('footer'):null}) %>
      <%- include('../partials/directoryShop',{placement:'airline_directory'}) %>
    </section>
    <aside class="pv-directory-rail" aria-label="Stories, reviews and services">
      <%- include('../partials/petPhotoAccent',{photo:'babies.jpg',photoAlt:'The two PetVoyage dogs on a palm-lined beach',photoWidth:1600,photoHeight:1273,message:'The dogs behind PetVoyage',photoNote:'Together at the beach.'}) %>
      <%- include('../partials/favBlog') %>
      <%- include('../partials/favReview') %>
      <%- include('../partials/ads/conciergeAd',{placement:'right-rail'}) %>
      <%- include('../partials/ads/taxiAd',{placement:'right-rail'}) %>
      <%- include('../partials/ads/ad-image',{ad:typeof getAd==='function'?getAd('header'):null}) %>
    </aside>
  </div>
</div>
