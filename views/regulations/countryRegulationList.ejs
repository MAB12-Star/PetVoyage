<% layout('layouts/boilerplate') %>
<div class="pv-wrap pv-directory">
  <h1>Pet travel requirements by country</h1>
  <p>Choose a destination and pet to find entry rules and travel documents.</p>
  <form id="countryForm" class="pv-directory-lookup">
    <div class="pv-directory-fields">
      <label>Destination country<select id="countrySelect" class="form-select" required><option value="">Choose a country</option>
        <% countryLinks.forEach(entry=>{ %><option><%= entry.country %></option><% }) %>
      </select></label>
      <label>Pet type<select id="countryPet" class="form-select" required disabled><option value="">Choose a pet</option></select></label>
      <button class="pv-button">View requirements →</button>
    </div>
  </form>
  <div class="pv-directory-columns">
    <section>
      <h2>Browse by country</h2>
      <div class="pv-directory-results" id="countryResults">
        <% countryLinks.forEach(entry=>{ %>
          <article class="pv-note pv-directory-card" data-country="<%= entry.country %>">
            <h3><%= entry.country %></h3>
            <div class="pv-directory-pets">
              <% entry.pets.forEach(pet=>{ %><a href="/country/<%= encodeURIComponent(entry.country) %>?petType=<%= encodeURIComponent(pet.slug) %>"><%= pet.label %></a><% }) %>
            </div>
          </article>
        <% }) %>
      </div>
      <%- include('../partials/directoryShop',{placement:'country_directory'}) %>
      <%- include('../partials/ads/ad-image',{ad:typeof getAd==='function'?getAd('footer'):null}) %>
    </section>
    <aside class="pv-directory-rail" aria-label="PetVoyage stories, reviews and tips">
      <%- include('../partials/petPhotoAccent',{photo:'eva.jpg',photoAlt:'Eva looking toward the city',photoWidth:1600,photoHeight:1200,message:'The dogs behind PetVoyage',photoNote:'Eva, from our family album.'}) %>
      <%- include('../partials/favBlog') %>
      <%- include('../partials/favReview') %>
      <article class="card"><img src="/images/Bird2.png" alt="Pets in a travel suitcase" loading="lazy"><div class="card-body"><h2>Featured tip</h2><p>Top 5 Tricks for Stress-Free Pet Travel</p><a href="/tips">Read tips →</a></div></article>
      <%- include('../partials/toDoList') %>
    </aside>
  </div>
</div>
<script src="/country-directory.js" defer></script>
