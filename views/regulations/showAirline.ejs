<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/styleSheets/stars.css">

<main class="pv-wrap pv-airline-detail">
  <a href="/regulations/airlineList">← Browse airline pet policies</a>
  <header class="pv-airline-heading">
    <div>
      <% if (airline.logo) { %><img class="pv-directory-logo" src="<%= airline.logo %>" alt="" width="96" height="52"><% } %>
      <h1><%= airline.name %> pet travel policy</h1>
    </div>
<!-- Save Button -->
<form method="POST" action="/favorites/saveAirlineToFavorites">
  <input type="hidden" name="airlineId" value="<%= airline._id %>">
  <input type="hidden" name="slug" value="<%= airline.slug %>">
  <input type="hidden" name="link" value="/airlines/<%= airline.slug %>">

  <input type="hidden" name="airlineCode" value="<%= airline.airlineCode %>">
  <input type="hidden" name="airlineName" value="<%= airline.name %>">
  <input type="hidden" name="petPolicyURL" value="<%= airline.petPolicyURL || '' %>">

  <!-- If petPolicySummary is long HTML, better to NOT send it via hidden input -->
  <button type="submit" class="btn btn-outline-danger fw-semibold">
    <i class="fas fa-heart me-1"></i> Save
  </button>
</form>

  </header>
  <div class="pv-airline-actions">
    <% if (airline.petPolicyURL?.trim()) { %>
      <a class="pv-button" href="<%= airline.petPolicyURL %>" target="_blank" rel="noopener noreferrer">Official airline policy ↗</a>
    <% } else { %>
      <p>Confirm requirements directly with the operating airline.</p>
    <% } %>
    <a href="/plan">Plan a trip</a>
  </div>
  <nav class="pv-airline-sections" aria-label="On this page">
    <a href="#summary">Summary</a><a href="#health">Health documents</a><a href="#restrictions">Breed restrictions</a>
    <a href="#support">Service and support animals</a><a href="#carrier">Carriers</a><a href="#reviews">Reviews</a>
  </nav>

  <!-- ===== TOP DOG SHOPIFY AD ===== -->


<% const headerAd = (typeof getAd === 'function') ? getAd('header') : null; %>
<% if (headerAd) { %>
  <%- include('../partials/ads/ad-image', { ad: headerAd }) %>
<% } %>



  <div class="pv-directory-columns">
    <div>
      <section id="summary" class="card pv-airline-panel">
        <h2>Policy summary</h2>
        <div><%- airline.ImprovedPetPolicySummary || 'Pet policy summary not available.' %></div>
      </section>
    </div>
    <aside class="pv-airline-services" aria-label="Sponsored pet travel services">
      <% const serviceAds = ['../partials/ads/taxiAd','../partials/ads/conciergeAd']; %>
      <%- include(serviceAds[Math.floor(Math.random() * serviceAds.length)]) %>
    </aside>
  </div>

  <!-- ===== 2x2 SECTIONS ===== -->
  <div class="row g-3 pv-airline-details">
    <section id="health" class="col-md-6">
      <div class="card pv-airline-panel h-100">
        <h2><i class="bi bi-heart-pulse me-2"></i>Health Requirements</h2>
        <p><strong>Microchip:</strong> <%- airline.microchip || "Not specified." %></p>
        <p><strong>Health Certificate:</strong> <%- airline.healthCertificate || "Not specified." %></p>
        <p><strong>Vaccinations:</strong> <%- (Array.isArray(airline.healthVaccinations) ? airline.healthVaccinations.join(', ') : airline.healthVaccinations) || "Not specified." %></p>
     


  <!-- ✅ AD FROM YOUR ADMIN ADS MODULE (ONLY IF AVAILABLE) -->
      <%
        // Fallback-safe ad getter: uses your existing getAd() if it's available
        const safeGetAd = (placement) => (typeof getAd === 'function' ? getAd(placement) : null);

        // If RIGHT_CARD_TOP_PLACEMENT isn't defined, default to a valid placement from your schema
        const RIGHT_CARD_TOP_PLACEMENT_SAFE =
          (typeof RIGHT_CARD_TOP_PLACEMENT !== 'undefined' && RIGHT_CARD_TOP_PLACEMENT)
            ? RIGHT_CARD_TOP_PLACEMENT
            : 'inline-grid-2';

        const rightTopAd = safeGetAd(RIGHT_CARD_TOP_PLACEMENT_SAFE);
      %>

      <% if (rightTopAd) { %>
        <div class="mt-3">
          <%- include('../partials/ads/ad-image', { ad: rightTopAd }) %>
        </div>
      <% } %>
      </div>
    </section>

    <section id="restrictions" class="col-md-6">
      <div class="card pv-airline-panel h-100">
        <h2><i class="bi bi-exclamation-triangle me-2"></i>Restrictions</h2>
        <p><strong>Brachycephalic Breeds:</strong> <%- airline.brachycephalicBreedList || "Not specified." %></p>
        <p><strong>Breed restrictions:</strong> <%- airline.dangerousBreedList || "Not specified." %></p>
      </div>
    </section>

    <section id="support" class="col-md-6">
      <div class="card pv-airline-panel h-100">
        <h2><i class="bi bi-paw me-2"></i>Support Animals</h2>
        <p><strong>Service Animals:</strong> <%- airline.serviceAnimalDetails || "Not specified." %></p>
        <p><strong>Emotional Support:</strong> <%- airline.esaDetails || "Not specified." %></p>
      </div>
    </section>

    <section id="carrier" class="col-md-6">
      <div class="card pv-airline-panel h-100">
        <h2><i class="bi bi-truck me-2"></i>Carrier Details</h2>
        <p><strong>In cabin:</strong> <%- airline.carrierCompartmentDetails || "Not specified." %></p>
        <p><strong>Cargo:</strong> <%- airline.carrierCargoDetails || "Not specified." %></p>
      </div>
    </section>
  </div>
  

  <!-- ===== REVIEWS ===== -->
  <section id="reviews" class="mt-5">
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h2>Traveler reviews</h2>

        <p>Read firsthand experiences travelling with pets.</p>
        <a class="btn btn-success mb-3" href="/airlines/review/new?airline=<%= encodeURIComponent(airline.slug) %>">Write an airline review</a>
        <%- include('../partials/airlineReviewList', {items: reviews, deleteSlug: airline.slug}) %>
      </div>
    </div>
  </section>

  <!-- ===== CAT AD AT BOTTOM ===== -->
   <!--Ads-->
<%
  const footer = (typeof getAd === 'function') ? getAd('footer') : null;
%>
<% if (footer) { %>
  <%- include('../partials/ads/ad-image', { ad: footer }) %>
<% } %>

<%- include('../partials/relatedStories',{stories:typeof relatedStories !== 'undefined' ? relatedStories : []}) %>
</main>
