<form class="pv-trip-remove" method="post" action="/my-trips/<%= kind %>/<%= trip._id %>/<%= removed ? 'restore' : 'remove' %>"><button type="submit" class="pv-trip-remove-button" title="<%= removed ? 'Restore saved trip' : 'Remove saved trip' %>" aria-label="<%= (removed ? 'Restore ' : 'Remove ') + (trip.destinationCity || trip.destination || trip.country || 'saved trip') %>"><% if(removed){ %>Restore<% }else{ %><span aria-hidden="true">×</span><% } %></button></form>