<section class="pv-section pv-related" aria-label="Community travel stories">
  <div class="pv-section-head"><div><p class="pv-eyebrow">From the community</p><h2>Experience gives you better questions.</h2><p>Personal stories offer perspective; confirm current rules for your own journey.</p></div><a href="/blog" class="pv-text-link">All stories →</a></div>
  <% if (stories && stories.length) { %><div class="pv-story-grid"><% stories.forEach(item => { %>
    <article class="pv-story-card"><% if (item.photos && item.photos[0]) { %><a href="/blog/<%= encodeURIComponent(item.slug || String(item._id)) %>"><img src="<%= item.photos[0].thumbUrl || item.photos[0].url %>" alt="<%= item.photos[0].alt || item.title %>" loading="lazy" width="500" height="320"></a><% } %><div class="pv-story-copy"><p class="pv-eyebrow">Published story<% if (item.country) { %> · <%= item.country %><% } %></p><h3><a href="/blog/<%= encodeURIComponent(item.slug || String(item._id)) %>"><%= item.title %></a></h3><% if (item.authorName || item.author?.displayName) { %><p class="pv-fine-print">By <%= item.authorName || item.author.displayName %></p><% } %><p><%= item.summary || 'Read the original story, photos and conversation.' %></p><a class="pv-text-link" href="/blog/<%= encodeURIComponent(item.slug || String(item._id)) %>">Read the story →</a></div></article>
  <% }) %></div><% } else { %><div class="pv-note">No matching stories have been published yet. <a href="/blog/new">Share your own experience</a> or explore the full community.</div><% } %>
</section>
