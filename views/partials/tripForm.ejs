<form class="pv-planner" action="/plan/start" method="post"><p class="pv-eyebrow">Plan with Scout · PetVoyage AI</p><h2>One trip.<br>Everything brought together.</h2><p>Find the route and prepare for travelling with your pet.</p><% const selected=typeof plan!=='undefined'&&plan?plan:{}; %><%- include('departureLocation') %><div class="pv-fields"><label>Leaving from<select name="origin" required><option value="">Choose country</option><% countries.forEach(c=>{ %><option <%= selected.origin===c.destinationCountry?'selected':'' %>><%= c.destinationCountry %></option><% }) %></select></label><label>Travelling to<select name="destination" required><option value="">Choose destination</option><% countries.forEach(c=>{ %><option <%= selected.destination===c.destinationCountry?'selected':'' %>><%= c.destinationCountry %></option><% }) %></select></label><label>Destination city or airport (optional)<input name="destinationCity" maxlength="100" value="<%= selected.destinationCity || '' %>" placeholder="e.g. Puerto Vallarta"></label><label>Departure airport or city (optional)<input name="departureCity" maxlength="100" value="<%= selected.departureCity || '' %>" placeholder="Your departure"></label><label>Your companion<select name="pet" required><% [['dog','Dog'],['cat','Cat'],['bird','Bird'],['other','Other pet']].forEach(([v,n])=>{ %><option value="<%= v %>" <%= selected.petType===v?'selected':'' %>><%= n %></option><% }) %></select></label><label>Departure date (optional)<input name="departure" type="date" value="<%= selected.departureDate || '' %>"></label><label>Return date (optional)<input name="returnDate" type="date" value="<%= selected.returnDate || '' %>"></label><label>Airline (if known)<select name="airline"><option value="">Not chosen yet</option><% (typeof airlines!=='undefined'?airlines:[]).forEach(a=>{ %><option value="<%= a._id %>" <%= selected.airlineId===String(a._id)?'selected':'' %>><%= a.name %></option><% }) %></select></label><label>Flight number (optional)<input name="flightNumber" maxlength="16" value="<%= selected.flightNumber || '' %>" placeholder="e.g. Y4771"><small>Select the airline above for its pet policy.</small></label></div><input type="hidden" name="departureSource" value="<%= selected.departureSource==='location-suggested'?'location':'manual' %>"><details class="mt-3" <%= selected.airlineId?'open':'' %>><summary>More trip details</summary><div class="pv-fields"><label>Airport code (optional)<input name="departureAirport" maxlength="3" pattern="[A-Za-z]{3}" value="<%= selected.departureAirport || '' %>" placeholder="e.g. LAX"></label><label>Destination airport code (optional)<input name="destinationAirport" maxlength="3" pattern="[A-Za-z]{3}" value="<%= selected.destinationAirport || '' %>" placeholder="e.g. PVR"></label><label>Transit countries (optional)<input name="transit" maxlength="200" value="<%= selected.transit || '' %>"></label></div></details><button class="pv-button" type="submit">Build my AI itinerary →</button><p class="pv-fine-print">Confirm final travel requirements and pet acceptance with official authorities and the airline.</p></form><script src="/airport-handoff.js" defer></script>
