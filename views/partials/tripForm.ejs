<% const tr = typeof translatePlanner === 'function' ? translatePlanner : value => value; %><form class="pv-planner" action="/plan/start" method="post"><p class="pv-eyebrow">Plan with Scout · PetVoyage AI</p><h2>One trip.<br>Everything brought together.</h2><p>Find the route and prepare for travelling with your pet.</p><% const selected=typeof plan!=='undefined'&&plan?plan:{}; %><fieldset class="pv-trip-departure"><legend><%= tr("Departure") %></legend><div class="pv-fields"><label><%= tr("Leaving from") %><select name="origin" required><option value=""><%= tr("Choose country") %></option><% countries.forEach(c=>{ %><option <%= selected.origin===c.destinationCountry?'selected':'' %>><%= c.destinationCountry %></option><% }) %></select></label><label><%= tr("Departure airport or city (optional)") %><input name="departureCity" maxlength="100" value="<%= selected.departureCity || '' %>" placeholder="<%= tr('Your departure') %>"></label></div><%- include('departureLocation') %></fieldset><div class="pv-fields"><label><%= tr("Travelling to") %><select name="destination" required><option value=""><%= tr("Choose destination") %></option><% countries.forEach(c=>{ %><option <%= selected.destination===c.destinationCountry?'selected':'' %>><%= c.destinationCountry %></option><% }) %></select></label><label><%= tr("Destination city (optional)") %><select class="pv-destination-city" name="destinationCity"><option value=""><%= selected.destination ? 'Any city (country-wide search)' : 'Choose a destination country first' %></option><% if (selected.destinationCity) { %><option selected><%= selected.destinationCity %></option><% } %></select></label><label><%= tr("Destination airport (optional)") %><select name="destinationAirport" class="pv-destination-airport" data-selected="<%= selected.destinationAirport || '' %>"><option value="<%= selected.destinationAirport || '' %>"><%= selected.destinationAirport || 'Choose an airport (optional)' %></option></select><small class="pv-airport-list-status"><%= tr("Choose a destination country to see its airports.") %></small></label><label><%= tr("Your companion") %><select name="pet" required><% [['dog','Dog'],['cat','Cat'],['dog-and-cat','Dog and cat'],['bird','Bird'],['other','Other pet']].forEach(([v,n])=>{ %><option value="<%= v %>" <%= selected.petType===v?'selected':'' %>><%= tr(n) %></option><% }) %></select></label><label><%= tr("Departure date (optional)") %><input name="departure" type="date" value="<%= selected.departureDate || '' %>"></label><label><%= tr("Return date (optional)") %><input name="returnDate" type="date" value="<%= selected.returnDate || '' %>"></label><label><%= tr("Airline (if known)") %><select name="airline"><option value=""><%= tr("Not chosen yet") %></option><% (typeof airlines!=='undefined'?airlines:[]).forEach(a=>{ %><option value="<%= a._id %>" <%= selected.airlineId===String(a._id)?'selected':'' %>><%= a.name %></option><% }) %></select></label><label><%= tr("Flight number (optional)") %><input name="flightNumber" maxlength="16" value="<%= selected.flightNumber || '' %>" placeholder="e.g. Y4771"><small><%= tr("Select the airline above for its pet policy.") %></small></label></div><input type="hidden" name="departureSource" value="<%= selected.departureSource==='location-suggested'?'location':'manual' %>"><details class="mt-3" <%= selected.airlineId?'open':'' %>><summary><%= tr("More trip details") %></summary><div class="pv-fields"><label><%= tr("Airport code (optional)") %><input name="departureAirport" maxlength="3" pattern="[A-Za-z]{3}" value="<%= selected.departureAirport || '' %>" placeholder="e.g. LAX"></label><label><%= tr("Transit countries (optional)") %><input name="transit" maxlength="200" value="<%= selected.transit || '' %>"></label></div></details><button class="pv-button" type="submit"><%= tr("Build my AI itinerary →") %></button><p class="pv-fine-print"><%= tr("Confirm final travel requirements and pet acceptance with official authorities and the airline.") %></p></form><script src="/airport-handoff.js" defer></script>

<script src="/destination-airports.js" defer></script><script src="/destination-city-suggestions.js" defer></script>
